# ============================================================
# Telecom Copilot POC — IBM BOB Hackathon 2026
# COPY this file to .env and fill in your credentials.
# NEVER commit .env — it is git-ignored.
# ============================================================

# ── Runtime mode ─────────────────────────────────────────────
# Set to "false" ONLY for live demo (ST-6). Keep "true" always otherwise.
USE_MOCK=true

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# ── watsonx.ai (Granite 13B) ─────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM NLU ──────────────────────────────────────────────────
NLU_API_KEY=
NLU_URL=

# ── IBM Cloudant ─────────────────────────────────────────────
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DB_INCIDENTS=incidents
CLOUDANT_DB_TICKETS=tickets
CLOUDANT_DB_AUDIT=audit_trail
CLOUDANT_DB_KNOWLEDGE=knowledge_base

# ── Watson Orchestrate (ST-4 only) ───────────────────────────
WATSON_ORCHESTRATE_URL=
WATSON_ORCHESTRATE_API_KEY=

# ── ChromaDB (local — no credentials needed) ─────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_KB=telecom_knowledge_base
CHROMA_COLLECTION_PATTERNS=outage_patterns
